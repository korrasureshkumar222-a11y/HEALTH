NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://chronic_local_admin:replace-with-local-only-password@127.0.0.1:27017/chronic-care?authSource=admin
DB_CONNECT_MAX_RETRIES=5
DB_RETRY_BASE_DELAY_MS=1000
JWT_ACCESS_SECRET=replace-this-development-access-secret-with-a-long-random-value
JWT_REFRESH_SECRET=replace-this-development-refresh-secret-with-a-different-random-value
PII_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=15
AUTH_BCRYPT_ROUNDS=12
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
SMS_WEBHOOK_RATE_LIMIT=20
READING_RULESET_VERSION=demo-v1
READING_THRESHOLDS_JSON=
ALERT_DEDUPE_WINDOW_MINUTES=30
ALERT_ESCALATION_MINUTES=15
SMS_PROVIDER=mock
SMS_API_URL=
SMS_API_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=http://localhost:5000/api/sms/inbound
SMS_LOG_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters
SMS_INBOUND_RATE_LIMIT=5
SMS_INBOUND_RATE_WINDOW_MINUTES=15
COOKIE_SECURE=false
TRUST_PROXY=0
LOG_LEVEL=info
SENTRY_DSN=
SEED_PASSWORD=replace-with-a-local-development-password
